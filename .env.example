PORT=8787
CIEAV_API_PORT=8787
CIEAV_CONTROL_PORT=8790
CIEAV_GATEWAY_PORT=8791
CIEAV_STATE_DIR=
CIEAV_PROFILE_DIR=
CIEAV_START_URL=
CIEAV_SQLITE_PATH=.cieav/cieav.sqlite3
CIEAV_CLOUD_URL=
CIEAV_CLOUD_TIMEOUT_SECONDS=8
CIEAV_VERSION=0.7.0
CIEAV_LOCAL_MODEL_ENABLED=0
CIEAV_CLOUD_SERVER=0

# Optional narrow TLS listener for remote Effect Node pairing + signed heartbeats.
CIEAV_NODE_INGRESS_BIND=
CIEAV_NODE_INGRESS_PORT=8794
CIEAV_NODE_INGRESS_TLS_CERT_FILE=
CIEAV_NODE_INGRESS_TLS_KEY_FILE=

# Standalone CIEAV Effect Node. Capabilities are explicit/default-deny.
CIEAV_NODE_STATE_DIR=
CIEAV_NODE_CAPABILITIES_FILE=
CIEAV_NODE_NAME=
CIEAV_NODE_BIND=127.0.0.1
CIEAV_NODE_PORT=8793
CIEAV_NODE_ADVERTISE_URL=
CIEAV_GATEWAY_URL=http://127.0.0.1:8787
CIEAV_NODE_TLS_CERT_FILE=
CIEAV_NODE_TLS_KEY_FILE=
CIEAV_NODE_CAPACITY=1
# Normally provisioned by `cieav-node pair`; do not put production secrets here.
CIEAV_NODE_TOKEN=
CIEAV_GATEWAY_AUTHORITY_PUBLIC_KEY_FILE=

# CIEAV Model Fabric uses one OpenAI-compatible /v1 contract for self-hosted
# CPU/GPU inference, private infrastructure, and hosted inference providers.
# Production remote endpoints must use HTTPS; loopback HTTP is development-only.
# Self-host example:
CIEAV_CLOUD_MODEL_BASE_URL=http://127.0.0.1:8000/v1
# Hugging Face Inference Providers alternative:
# CIEAV_CLOUD_MODEL_BASE_URL=https://router.huggingface.co/v1

# Primary open-weight target selected for agent/coding quality and practical
# self-hosting flexibility. Model choice never changes CIEAV execution authority.
CIEAV_CLOUD_MODEL=Qwen/Qwen3.6-27B
CIEAV_CLOUD_FAST_MODEL=Qwen/Qwen3.6-27B
CIEAV_CLOUD_VERIFIER_MODEL=Qwen/Qwen3.6-27B

# For stronger independent verification, point VERIFIER at a different suitable
# model/provider. If it equals PRIMARY, CIEAV reports verification as degraded.
# For Hugging Face hosted inference, use a fine-grained inference token here;
# never commit it to source control.
CIEAV_CLOUD_MODEL_REVISION=
CIEAV_CLOUD_MODEL_DIGEST=
CIEAV_CLOUD_MODEL_API_KEY=
CIEAV_CLOUD_MODEL_TIMEOUT_MS=30000

# Model Fabric Reliability v1. Values are bounded by the runtime.
CIEAV_MODEL_FAILURE_THRESHOLD=3
CIEAV_MODEL_COOLDOWN_MS=15000
CIEAV_MODEL_MAX_CONCURRENT=32
