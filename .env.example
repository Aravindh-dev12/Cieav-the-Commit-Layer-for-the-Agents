PORT=8787
CIEAV_API_PORT=8787
CIEAV_CONTROL_PORT=8790
CIEAV_GATEWAY_PORT=8791
CIEAV_STATE_DIR=
CIEAV_PROFILE_DIR=
CIEAV_START_URL=
CIEAV_SQLITE_PATH=.cieav/cieav.sqlite3
CIEAV_CLOUD_URL=
CIEAV_CLOUD_TIMEOUT_SECONDS=8
CIEAV_VERSION=0.8.0

# Runtime mode. In NODE_ENV=production the AI provider registry is intended to
# fail closed unless exact model qualification is explicitly configured.
NODE_ENV=development

# Optional explicit trusted execution-adapter catalog. If unset, CIEAV uses
# <CIEAV_STATE_DIR>/execution-adapters.json. A configured missing/invalid file
# fails closed rather than silently disabling the requested adapters.
CIEAV_EXECUTION_ADAPTERS_FILE=

# Optional exact-ref local Git proof catalog. Git execution and Git proof are
# deliberately configured separately so the proof path does not inherit
# mutation authority from the execution adapter.
CIEAV_PROOF_GIT_REF_CATALOG=

# Optional exact-ref remote Git Smart HTTP proof catalog. Keep this separate
# from the execution catalog and, in production, use read-only credentials
# independent from the credential capable of publishing refs.
CIEAV_PROOF_GIT_REMOTE_REF_CATALOG=

# Optional Kubernetes Deployment read-only proof catalog. Keep its bearer token
# distinct from the execution token and grant only GET permission on the exact
# Deployment resources that the proof provider is expected to observe.
CIEAV_PROOF_KUBERNETES_DEPLOYMENT_CATALOG=

# Optional AWS EC2 read-only proof catalog. Production should use credentials
# distinct from the stop credential and grant only ec2:DescribeInstances for
# the intended proof principal; the execution principal remains separately bound.
CIEAV_PROOF_AWS_EC2_CATALOG=

# Optional Azure VM read-only proof catalog. Production should use a token
# distinct from the deallocate token, scoped to ARM with read-only permission
# sufficient for instanceView on the exact VM resource.
CIEAV_PROOF_AZURE_VM_CATALOG=

# Optional GCP Compute Engine read-only proof catalog. Production should use a
# token distinct from the stop token with only the permissions needed to GET
# the exact VM instances that proof is expected to observe.
CIEAV_PROOF_GCP_COMPUTE_CATALOG=

# Optional independent desktop UI proof catalog. The proof observer helper must
# be a separately built and digest-pinned read-only native binary. Do not reuse
# the execution or preflight helper binary for production proof settlement.
CIEAV_PROOF_DESKTOP_UI_CATALOG=

# Production Cloud deployments must set these to the exact release identity.
# Public deployment qualification rejects missing or mismatched values.
CIEAV_BUILD_VERSION=0.8.0
CIEAV_BUILD_COMMIT=
CIEAV_LOCAL_MODEL_ENABLED=0
CIEAV_CLOUD_SERVER=0

# -----------------------------------------------------------------------------
# CIEAV Qualified Frontier AI Provider Router
# -----------------------------------------------------------------------------
# Models/agents are intelligence only: authority=false. They never issue CIEAV
# execution tickets, settle consequences, grant credentials, or bypass Algebra.
# Provider fallback is for availability failures only. Policy/safety refusals,
# authentication failures, bad configuration, and invalid responses are not
# automatically vendor-shopped around.

CIEAV_AI_PROFILE=balanced
CIEAV_AI_TIMEOUT_MS=9500
CIEAV_AI_PROVIDER_ORDER=openai,kimi,anthropic,gemini,xai
CIEAV_AI_RESEARCH_PROVIDER_ORDER=openai,kimi,anthropic,gemini,xai
CIEAV_AI_CROSS_PROVIDER_VERIFY=1

# Exact model qualification. In production set this to 1 and provide the file.
# When CIEAV_STATE_DIR is set, the default path is:
#   <CIEAV_STATE_DIR>/qualified-models.json
# File envelope:
#   {"version":"CIEAV_QUALIFIED_MODELS_V1","models":[...],"authority":false}
# Each entry binds provider + host + exact model + roles + qualification receipt.
CIEAV_AI_REQUIRE_QUALIFIED_MODELS=0
CIEAV_AI_QUALIFIED_MODELS_FILE=

# OpenAI / GPT provider. Existing CIEAV_AI_* variables remain supported for
# backward compatibility, while CIEAV_OPENAI_* is the canonical provider form.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CIEAV_OPENAI_ENABLED=
CIEAV_OPENAI_FAST_MODEL=gpt-5.6-luna
CIEAV_OPENAI_PRIMARY_MODEL=gpt-5.6
CIEAV_OPENAI_VERIFIER_MODEL=gpt-5.6-terra
CIEAV_OPENAI_RESEARCH_MODEL=gpt-5.6
CIEAV_OPENAI_TIMEOUT_MS=9500

# Legacy OpenAI role aliases retained for installed deployments.
CIEAV_AI_FAST_MODEL=gpt-5.6-luna
CIEAV_AI_PRIMARY_MODEL=gpt-5.6
CIEAV_AI_VERIFIER_MODEL=gpt-5.6-terra

# Moonshot AI / Kimi. Verify the account-visible model catalog during
# qualification and pin the exact model identity in qualified-models.json.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
CIEAV_KIMI_ENABLED=
CIEAV_KIMI_FAST_MODEL=kimi-k3
CIEAV_KIMI_PRIMARY_MODEL=kimi-k3
CIEAV_KIMI_VERIFIER_MODEL=kimi-k3
CIEAV_KIMI_RESEARCH_MODEL=kimi-k3
CIEAV_KIMI_TIMEOUT_MS=15000

# Anthropic / Claude. No model is silently invented if your deployment has a
# different catalog: set the exact account-visible model ID explicitly.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
CIEAV_ANTHROPIC_ENABLED=
CIEAV_ANTHROPIC_MODEL=
CIEAV_ANTHROPIC_FAST_MODEL=
CIEAV_ANTHROPIC_PRIMARY_MODEL=
CIEAV_ANTHROPIC_VERIFIER_MODEL=
CIEAV_ANTHROPIC_RESEARCH_MODEL=
CIEAV_ANTHROPIC_TIMEOUT_MS=15000

# Google Gemini API. Pin an exact account-visible model; previews should not be
# used on consequential production paths without an explicit qualified receipt.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
CIEAV_GEMINI_ENABLED=
CIEAV_GEMINI_MODEL=
CIEAV_GEMINI_FAST_MODEL=
CIEAV_GEMINI_PRIMARY_MODEL=
CIEAV_GEMINI_VERIFIER_MODEL=
CIEAV_GEMINI_RESEARCH_MODEL=
CIEAV_GEMINI_TIMEOUT_MS=15000

# xAI / Grok.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
CIEAV_XAI_ENABLED=
CIEAV_XAI_FAST_MODEL=grok-4.6
CIEAV_XAI_PRIMARY_MODEL=grok-4.6
CIEAV_XAI_VERIFIER_MODEL=grok-4.6
CIEAV_XAI_RESEARCH_MODEL=grok-4.6
CIEAV_XAI_TIMEOUT_MS=15000

# Hugging Face semantic-router path retained as the privacy-minimizing first
# tier when configured. Its capability token must remain distinct from Gateway
# admin authority in managed mode.
CIEAV_HF_ENABLED=0
CIEAV_HF_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# CIEAV Private / Self-Hosted Inference
# -----------------------------------------------------------------------------
# OpenAI-compatible /v1 endpoint. Production must use HTTPS. Plain HTTP is
# accepted only for loopback testing.
CIEAV_CLOUD_MODEL_BASE_URL=http://127.0.0.1:8000/v1

# Private Model Router roles. These can point to vLLM, SGLang, llama.cpp or
# another explicitly qualified compatible service. Exact revision/digest is
# required for production provenance; wire compatibility is not trust.
CIEAV_CLOUD_MODEL=Qwen/Qwen3.6-35B-A3B
CIEAV_CLOUD_FAST_MODEL=Qwen/Qwen3.6-35B-A3B
CIEAV_CLOUD_VERIFIER_MODEL=Qwen/Qwen3.6-35B-A3B
CIEAV_CLOUD_MODEL_REVISION=
CIEAV_CLOUD_MODEL_DIGEST=
CIEAV_CLOUD_MODEL_API_KEY=
CIEAV_CLOUD_MODEL_TIMEOUT_MS=10000

# Model Fabric Reliability v1. Values are bounded by the runtime.
CIEAV_MODEL_FAILURE_THRESHOLD=3
CIEAV_MODEL_COOLDOWN_MS=15000
CIEAV_MODEL_MAX_CONCURRENT=32

# -----------------------------------------------------------------------------
# Managed ML / RL provider credentials
# -----------------------------------------------------------------------------
# Do not grant any of these services CIEAV signing keys, Gateway admin tokens,
# reusable execution credentials, or promotion authority. Training outputs are
# CANDIDATE until deterministic CIEAV qualification promotes them.
OPENAI_TRAINING_API_KEY=
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_ML_SUBSCRIPTION_ID=
AZURE_ML_RESOURCE_GROUP=
AZURE_ML_WORKSPACE=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
AWS_REGION=
AWS_PROFILE=
DATABRICKS_HOST=
DATABRICKS_TOKEN=
HF_TOKEN=
WANDB_API_KEY=
MLFLOW_TRACKING_URI=
