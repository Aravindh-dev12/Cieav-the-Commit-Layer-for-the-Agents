PORT=8787
CIEAV_API_PORT=8787
CIEAV_CONTROL_PORT=8790
CIEAV_GATEWAY_PORT=8791
CIEAV_STATE_DIR=
CIEAV_PROFILE_DIR=
CIEAV_START_URL=
CIEAV_SQLITE_PATH=.cieav/cieav.sqlite3
CIEAV_CLOUD_URL=
CIEAV_CLOUD_TIMEOUT_SECONDS=8
CIEAV_VERSION=0.8.0
NODE_ENV=development

CIEAV_EXECUTION_ADAPTERS_FILE=
CIEAV_PROOF_GIT_REF_CATALOG=
CIEAV_PROOF_GIT_REMOTE_REF_CATALOG=
CIEAV_PROOF_KUBERNETES_DEPLOYMENT_CATALOG=
CIEAV_PROOF_AWS_EC2_CATALOG=
CIEAV_PROOF_AZURE_VM_CATALOG=
CIEAV_PROOF_GCP_COMPUTE_CATALOG=
CIEAV_PROOF_DESKTOP_UI_CATALOG=

CIEAV_BUILD_VERSION=0.8.0
CIEAV_BUILD_COMMIT=
CIEAV_LOCAL_MODEL_ENABLED=0
CIEAV_CLOUD_SERVER=0

# -----------------------------------------------------------------------------
# CIEAV Qualified Frontier AI Provider Router
# -----------------------------------------------------------------------------
# Models and agents are intelligence only. They never issue execution tickets,
# settle consequences, grant credentials, or bypass Consequence Algebra.
CIEAV_AI_PROFILE=balanced
CIEAV_AI_TIMEOUT_MS=9500
CIEAV_AI_PROVIDER_ORDER=openai,kimi,anthropic,gemini,xai
CIEAV_AI_RESEARCH_PROVIDER_ORDER=openai,kimi,anthropic,gemini,xai
CIEAV_AI_CROSS_PROVIDER_VERIFY=1
CIEAV_AI_REQUIRE_QUALIFIED_MODELS=0
CIEAV_AI_QUALIFIED_MODELS_FILE=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CIEAV_OPENAI_ENABLED=
CIEAV_OPENAI_FAST_MODEL=gpt-5.6-luna
CIEAV_OPENAI_PRIMARY_MODEL=gpt-5.6
CIEAV_OPENAI_VERIFIER_MODEL=gpt-5.6-terra
CIEAV_OPENAI_RESEARCH_MODEL=gpt-5.6
CIEAV_OPENAI_TIMEOUT_MS=9500
CIEAV_AI_FAST_MODEL=gpt-5.6-luna
CIEAV_AI_PRIMARY_MODEL=gpt-5.6
CIEAV_AI_VERIFIER_MODEL=gpt-5.6-terra

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
CIEAV_KIMI_ENABLED=
CIEAV_KIMI_FAST_MODEL=kimi-k3
CIEAV_KIMI_PRIMARY_MODEL=kimi-k3
CIEAV_KIMI_VERIFIER_MODEL=kimi-k3
CIEAV_KIMI_RESEARCH_MODEL=kimi-k3
CIEAV_KIMI_TIMEOUT_MS=15000

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
CIEAV_ANTHROPIC_ENABLED=
CIEAV_ANTHROPIC_MODEL=
CIEAV_ANTHROPIC_FAST_MODEL=
CIEAV_ANTHROPIC_PRIMARY_MODEL=
CIEAV_ANTHROPIC_VERIFIER_MODEL=
CIEAV_ANTHROPIC_RESEARCH_MODEL=
CIEAV_ANTHROPIC_TIMEOUT_MS=15000

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
CIEAV_GEMINI_ENABLED=
CIEAV_GEMINI_MODEL=
CIEAV_GEMINI_FAST_MODEL=
CIEAV_GEMINI_PRIMARY_MODEL=
CIEAV_GEMINI_VERIFIER_MODEL=
CIEAV_GEMINI_RESEARCH_MODEL=
CIEAV_GEMINI_TIMEOUT_MS=15000

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
CIEAV_XAI_ENABLED=
CIEAV_XAI_FAST_MODEL=grok-4.6
CIEAV_XAI_PRIMARY_MODEL=grok-4.6
CIEAV_XAI_VERIFIER_MODEL=grok-4.6
CIEAV_XAI_RESEARCH_MODEL=grok-4.6
CIEAV_XAI_TIMEOUT_MS=15000

CIEAV_HF_ENABLED=0
CIEAV_HF_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# CIEAV Private / Self-Hosted Inference
# -----------------------------------------------------------------------------
CIEAV_CLOUD_MODEL_BASE_URL=http://127.0.0.1:8000/v1
CIEAV_CLOUD_MODEL=Qwen/Qwen3.6-35B-A3B
CIEAV_CLOUD_FAST_MODEL=Qwen/Qwen3.6-35B-A3B
CIEAV_CLOUD_VERIFIER_MODEL=Qwen/Qwen3.6-35B-A3B
CIEAV_CLOUD_MODEL_REVISION=
CIEAV_CLOUD_MODEL_DIGEST=
CIEAV_CLOUD_MODEL_API_KEY=
CIEAV_CLOUD_MODEL_TIMEOUT_MS=10000
CIEAV_MODEL_FAILURE_THRESHOLD=3
CIEAV_MODEL_COOLDOWN_MS=15000
CIEAV_MODEL_MAX_CONCURRENT=32

# -----------------------------------------------------------------------------
# CIEAV .NET 10 + Native C ABI Platform Host
# -----------------------------------------------------------------------------
# Platform/evidence infrastructure only: authority=false. Use a high-entropy
# secret from the OS secret store/service manager; never commit the real value.
CIEAV_DOTNET_PIPE_NAME=cieav-platform-v1
CIEAV_DOTNET_IPC_SECRET=
# Exact qualified library path: .dll on Windows, .so on Linux, .dylib on macOS.
CIEAV_NATIVE_LIBRARY=

# Consequence Algebra persistence mode. `file` is the currently qualified
# compatibility backend. `sqlite` is reserved for the multi-process backend and
# must not be enabled in production until its dedicated qualification passes.
CIEAV_CONSEQUENCE_ALGEBRA_STORE=file
CIEAV_CONSEQUENCE_ALGEBRA_SQLITE_PATH=.cieav/consequence-algebra.sqlite3

# -----------------------------------------------------------------------------
# Managed ML / RL providers
# -----------------------------------------------------------------------------
# All managed trainers run behind LearningProviderRegistry and the authenticated
# CIEAV learning queue. A successful provider job is still
# SUCCEEDED_UNQUALIFIED. No provider may promote a model or receive CIEAV
# execution/permit signing keys.
CIEAV_MANAGED_LEARNING_HTTP_TIMEOUT_MS=30000
CIEAV_MANAGED_LEARNING_JOB_TIMEOUT_MS=21600000
CIEAV_MANAGED_LEARNING_POLL_MS=5000

# OpenAI fine-tuning is access-dependent. The template is the exact provider
# request body; placeholders such as ${CIEAV_BASE_MODEL}, ${CIEAV_DATASET_URI},
# ${CIEAV_DATASET_DIGEST}, ${CIEAV_JOB_ID} are substituted by CIEAV.
CIEAV_OPENAI_TRAINING_ENABLED=0
OPENAI_TRAINING_API_KEY=
OPENAI_TRAINING_BASE_URL=https://api.openai.com/v1
CIEAV_OPENAI_FINE_TUNING_TEMPLATE=

# Azure Machine Learning REST jobs (2026 API). Access token should be injected
# by workload identity/service manager and scoped only to the training workspace.
CIEAV_AZURE_ML_TRAINING_ENABLED=0
AZURE_ML_ACCESS_TOKEN=
AZURE_ML_SUBSCRIPTION_ID=
AZURE_ML_RESOURCE_GROUP=
AZURE_ML_WORKSPACE=
AZURE_ML_API_VERSION=2026-03-01
CIEAV_AZURE_ML_JOB_TEMPLATE=
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=

# Vertex AI Custom Jobs. Access token should come from workload identity/ADC
# outside the training payload and must never be copied into dataset artifacts.
CIEAV_VERTEX_TRAINING_ENABLED=0
GOOGLE_CLOUD_ACCESS_TOKEN=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
CIEAV_VERTEX_JOB_TEMPLATE=

# AWS SageMaker AgentRFT. CIEAV signs requests with SigV4 directly; no CLI is
# required. Prefer short-lived role credentials. The config template must match
# the exact schema version returned by SageMaker for AgentRFT.
CIEAV_AWS_AGENT_RFT_ENABLED=0
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
CIEAV_AWS_AGENT_RFT_ROLE_ARN=
CIEAV_AWS_AGENT_RFT_SCHEMA_VERSION=
CIEAV_AWS_AGENT_RFT_CONFIG_TEMPLATE=

# Additional experiment/registry services; integration is opt-in and does not
# confer authority or promotion rights.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
HF_TOKEN=
WANDB_API_KEY=
MLFLOW_TRACKING_URI=
