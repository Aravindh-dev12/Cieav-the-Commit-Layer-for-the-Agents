PORT=8787
CIEAV_API_PORT=8787
CIEAV_CONTROL_PORT=8790
CIEAV_GATEWAY_PORT=8791
CIEAV_DEBUG_PORT=
CIEAV_CHROMIUM=
CIEAV_STATE_DIR=
CIEAV_PROFILE_DIR=
CIEAV_START_URL=
DATABASE_URL=postgres://cieav:cieav@localhost:5432/cieav
JWT_SECRET=replace-with-a-long-random-secret
RECEIPT_SIGNING_SECRET=replace-with-another-long-random-secret

# Production client: CIEAV Cloud Intelligence.
CIEAV_CLOUD_URL=
CIEAV_CLOUD_TIMEOUT_SECONDS=8
CIEAV_VERSION=0.7.0

# Optional enterprise/offline local semantic tier. Disabled for normal users.
CIEAV_LOCAL_MODEL_ENABLED=0
CIEAV_LOCAL_MODEL=ibm-granite/granite-4.1-3b
CIEAV_LOCAL_MODEL_URL=http://127.0.0.1:8000/v1
CIEAV_LOCAL_MODEL_TIMEOUT_SECONDS=8

# Optional direct Hugging Face fallback/diagnostics only.
# Do NOT put HF_TOKEN in this file for production. Use: cieav model hf-login
CIEAV_HF_MODEL=ibm-granite/granite-4.1-3b
CIEAV_HF_PROVIDER=auto
CIEAV_HF_ENDPOINT_URL=
CIEAV_HF_TIMEOUT_SECONDS=10
CIEAV_HF_TIMEOUT_MS=10000

# Optional frontier escalation from the local semantic bridge.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CIEAV_AI_PROFILE=balanced
CIEAV_AI_FAST_MODEL=gpt-5-mini
CIEAV_AI_PRIMARY_MODEL=gpt-5.1
CIEAV_AI_VERIFIER_MODEL=gpt-5-pro
CIEAV_AI_TIMEOUT_MS=9500
CIEAV_ALLOW_ORIGIN=http://127.0.0.1:8790,http://localhost:8790,http://localhost:5173

# CIEAV Cloud server deployment mode. Set on the cloud API service, not clients.
CIEAV_CLOUD_SERVER=0
CIEAV_CLOUD_MODEL_BASE_URL=http://127.0.0.1:8000/v1
CIEAV_CLOUD_MODEL=ibm-granite/granite-4.1-3b
CIEAV_CLOUD_MODEL_API_KEY=
CIEAV_CLOUD_MODEL_TIMEOUT_MS=10000

# Migration note: the current v0.7 runtime still accepts legacy LATCH_* names.
# New deployments should use CIEAV_* exclusively.
