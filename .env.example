PORT=8787
LATCH_API_PORT=8787
LATCH_CONTROL_PORT=8790
LATCH_GATEWAY_PORT=8791
LATCH_DEBUG_PORT=
LATCH_CHROMIUM=
LATCH_STATE_DIR=
LATCH_PROFILE_DIR=
LATCH_START_URL=
DATABASE_URL=postgres://latch:latch@localhost:5432/latch
JWT_SECRET=replace-with-a-long-random-secret
RECEIPT_SIGNING_SECRET=replace-with-another-long-random-secret

# Production client: LATCH Cloud Intelligence.
# The installer writes this from the verified release manifest.
LATCH_CLOUD_URL=
LATCH_CLOUD_TIMEOUT_SECONDS=8
LATCH_VERSION=0.7.0

# Optional enterprise/offline local semantic tier. Disabled for normal users.
LATCH_LOCAL_MODEL_ENABLED=0
LATCH_LOCAL_MODEL=ibm-granite/granite-4.1-3b
LATCH_LOCAL_MODEL_URL=http://127.0.0.1:8000/v1
LATCH_LOCAL_MODEL_TIMEOUT_SECONDS=8

# Optional direct Hugging Face fallback/diagnostics only.
# Do NOT put HF_TOKEN in this file for production. Use: latch model hf-login
LATCH_HF_MODEL=ibm-granite/granite-4.1-3b
LATCH_HF_PROVIDER=auto
LATCH_HF_ENDPOINT_URL=
LATCH_HF_TIMEOUT_SECONDS=10
LATCH_HF_TIMEOUT_MS=10000

# Optional frontier escalation from the local semantic bridge.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# economy | balanced | maximum
LATCH_AI_PROFILE=balanced
LATCH_AI_FAST_MODEL=gpt-5-mini
LATCH_AI_PRIMARY_MODEL=gpt-5.1
LATCH_AI_VERIFIER_MODEL=gpt-5-pro
LATCH_AI_TIMEOUT_MS=9500
LATCH_MODEL=
LATCH_ALLOW_ORIGIN=http://127.0.0.1:8790,http://localhost:8790,http://localhost:5173

# LATCH Cloud server deployment mode. Set on the cloud API service, not clients.
LATCH_CLOUD_SERVER=0
# Internal OpenAI-compatible Granite server reachable only from LATCH Cloud.
LATCH_CLOUD_MODEL_BASE_URL=http://127.0.0.1:8000/v1
LATCH_CLOUD_MODEL=ibm-granite/granite-4.1-3b
LATCH_CLOUD_MODEL_API_KEY=
LATCH_CLOUD_MODEL_TIMEOUT_MS=10000
