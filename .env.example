PORT=8787
LATCH_API_PORT=8787
LATCH_CONTROL_PORT=8790
LATCH_GATEWAY_PORT=8791
LATCH_DEBUG_PORT=
LATCH_CHROMIUM=
LATCH_STATE_DIR=
LATCH_PROFILE_DIR=
LATCH_START_URL=
DATABASE_URL=postgres://latch:latch@localhost:5432/latch
JWT_SECRET=replace-with-a-long-random-secret
RECEIPT_SIGNING_SECRET=replace-with-another-long-random-secret

# Primary semantic tier: local Granite through an OpenAI-compatible server.
# Recommended launch after downloading the model:
#   vllm serve ibm-granite/granite-4.1-3b --host 127.0.0.1 --port 8000
LATCH_LOCAL_MODEL_ENABLED=1
LATCH_LOCAL_MODEL=ibm-granite/granite-4.1-3b
LATCH_LOCAL_MODEL_URL=http://127.0.0.1:8000/v1
LATCH_LOCAL_MODEL_TIMEOUT_SECONDS=8

# Optional Hugging Face hosted fallback/model distribution credential.
# Do NOT put HF_TOKEN in this file for production. Use: latch model hf-login
LATCH_HF_MODEL=ibm-granite/granite-4.1-3b
LATCH_HF_PROVIDER=auto
LATCH_HF_ENDPOINT_URL=
LATCH_HF_TIMEOUT_SECONDS=10
LATCH_HF_TIMEOUT_MS=10000

# Optional frontier escalation. Used when the local/HF tier is unavailable,
# low-confidence, prompt-injection-suspect, UNKNOWN-reversibility, HIGH or CRITICAL.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# economy | balanced | maximum
LATCH_AI_PROFILE=balanced
# Pin evaluated model snapshots in production after your eval gate passes.
LATCH_AI_FAST_MODEL=gpt-5-mini
LATCH_AI_PRIMARY_MODEL=gpt-5.1
LATCH_AI_VERIFIER_MODEL=gpt-5-pro
LATCH_AI_TIMEOUT_MS=9500
# Legacy compatibility; LATCH_AI_PRIMARY_MODEL takes precedence.
LATCH_MODEL=
LATCH_ALLOW_ORIGIN=http://127.0.0.1:8790,http://localhost:8790,http://localhost:5173
