{
  "manifest_version": 3,
  "name": "LATCH — Action Safety Layer",
  "version": "0.1.0",
  "description": "Preview, understand, record and reverse consequential web actions when possible.",
  "minimum_chrome_version": "120",
  "permissions": ["storage","activeTab","scripting"],
  "host_permissions": ["http://*/*","https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html","default_title": "LATCH"},
  "options_page": "options.html",
  "content_scripts": [{"matches":["http://*/*","https://*/*"],"js":["content.js"],"run_at":"document_start","all_frames":true,"match_about_blank":true,"match_origin_as_fallback":true,"world":"ISOLATED"}],
  "icons": {"16":"icons/16.png","32":"icons/32.png","48":"icons/48.png","128":"icons/128.png"}
}
