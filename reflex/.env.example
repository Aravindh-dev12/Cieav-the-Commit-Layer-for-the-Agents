# Required: shared secret for the API and dashboard
API_KEY=change-me-to-a-long-random-string
PORT=3000
DB_PATH=/data/reflex.db
# Optional: real action driver. Receives POST {step, value}, returns {ok, text}.
# Leave empty to use the built-in simulated driver.
DRIVER_URL=

# Models (pick one; with none set, agent nodes use a deterministic offline stand-in)
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-4-6
OLLAMA_URL=
OLLAMA_MODEL=llama3.1
# Hostnames the pipeline http node may call (comma separated). Empty = none.
HTTP_ALLOW=

# Extra users: JSON array. clearance is public | internal | restricted; roles gate individual documents.
USERS=[{"key":"a-long-secret-for-alice","name":"alice","roles":["engineer"],"clearance":"internal"}]

# Python RAG service (parsing, embeddings, vector search). Leave RAG_URL empty to use the built-in lexical store.
RAG_URL=
RAG_SECRET=another-long-random-string
# EMBED_BACKEND=sbert for real sentence-transformer embeddings (build rag with requirements-sbert.txt); default is hash
EMBED_BACKEND=hash
# Entra ID SSO: users send 'Authorization: Bearer <access token>'. GROUP_MAP maps group object IDs to roles and clearance.
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=
GROUP_MAP={"<group-object-id>":{"roles":["engineer"],"clearance":"internal"}}
# Cost tracking (USD per million tokens)
PRICE_IN_PER_MTOK=0
PRICE_OUT_PER_MTOK=0

# Document approvals (Power Automate): with REQUIRE_APPROVAL=1 new or changed documents wait for a decision.
REQUIRE_APPROVAL=0
APPROVAL_FLOW_URL=
APPROVAL_SECRET=a-long-random-string-the-flow-sends-as-x-flow-secret
PUBLIC_URL=https://reflex.example.com
# GitLab: add a push webhook to https://<host>/hooks/gitlab with this secret token
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=
GITLAB_WEBHOOK_TOKEN=
GITLAB_DEFAULT_LEVEL=internal
DOC_PATHS=^docs/.+\.(md|txt)$
# Pull connectors (Waypoint export, Dynamics 365 Dataverse, any JSON API); run with POST /api/sync/<name>
PULL_SOURCES=[]
ASK_LIMIT_PER_HOUR=120
ENTRA_CLIENT_ID=
# Set OCR=1 (and build with WITH_OCR=1) to index scanned PDFs
OCR=0
WITH_OCR=0

# Outcome tracking (performance-linked pricing inputs)
TARGET_MODEL_FREE_RATE=0.6
MINUTES_PER_RUN=5
