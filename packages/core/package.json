{
  "name": "@cieav/core",
  "version": "0.4.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reality": {
      "types": "./dist/reality.d.ts",
      "import": "./dist/reality.js"
    },
    "./proof": {
      "types": "./dist/proof.d.ts",
      "import": "./dist/proof.js"
    },
    "./reconciliation": {
      "types": "./dist/reconciliation.d.ts",
      "import": "./dist/reconciliation.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js"
    },
    "./commitment": {
      "types": "./dist/commitment.d.ts",
      "import": "./dist/commitment.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cieav/contracts": "*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
